FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime
WORKDIR /app
COPY requirements.txt pyproject.toml ./
COPY inference/ ./inference/
COPY models/ ./models/
COPY config/ ./config/
COPY utils/ ./utils/
COPY src/ ./src/
RUN pip install --no-cache-dir -e ".[inference]"
EXPOSE 8000
CMD ["python", "-m", "inference.servers.fastapi_server"]