# Dados
DATA_PATH=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Modelo
MODEL_NAME=syon-7b
MODEL_PATH=./models
CHECKPOINT_PATH=./training/checkpoints

# Treinamento
BATCH_SIZE=32
LEARNING_RATE=2e-4
NUM_EPOCHS=3
WARMUP_STEPS=2000

# Inferência
INFERENCE_BATCH_SIZE=8
MAX_TOKEN_LENGTH=4096
INFERENCE_DEVICE=auto
INFERENCE_TEMPERATURE=0.7
INFERENCE_TOP_P=0.95

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=*
API_MAX_BODY_SIZE_MB=16
API_REQUEST_TIMEOUT=120

# Segurança
SECRET_KEY=your_secret_key_change_in_production
ALGORITHM=HS256
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60
ENABLE_INPUT_SANITIZATION=true

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs
SYON_ENV=development

# Distributed
WORLD_SIZE=1
RANK=0
MASTER_ADDR=localhost
MASTER_PORT=29500

# Integrações opcionais
WANDB_API_KEY=
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://user:pass@localhost:5432/syon